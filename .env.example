DISCORD_TOKEN=replace-me
MECHA_COMMAND_PREFIX=!
MECHA_EXTENSIONS=mecha.cogs.admin,mecha.cogs.voice,mecha.cogs.praise,mecha.cogs.league,mecha.cogs.music
MECHA_ACTIVITY_NAME=Mecha 01
MECHA_PRAISE_FILE=data/praises.txt
MECHA_TMP_DIR=tmp
MECHA_LEAGUE_API_URL=https://127.0.0.1:2999/liveclientdata/allgamedata
MECHA_LEAGUE_POLL_SECONDS=0.2
MECHA_AUTO_DISCONNECT_WHEN_ALONE=false
MECHA_AUTO_DISCONNECT_GRACE_SECONDS=30
MECHA_AUTO_DISCONNECT_CHECKS=3
MECHA_LOG_LEVEL=INFO
MECHA_MUSIC_MAX_PLAYLIST_SIZE=100
MECHA_MUSIC_IDLE_TIMEOUT_SECONDS=300
MECHA_SYNC_APP_COMMANDS=true
# Optional: set for instant slash command updates in one test server.
MECHA_SYNC_GUILD_ID=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
